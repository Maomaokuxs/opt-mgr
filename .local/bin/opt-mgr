#!/bin/bash
set -e

SCRIPT_NAME="opt-mgr"
CONF_DIR="$HOME/.config/opt-mgr"

usage() {
    cat <<'EOF'

用法:

  opt-mgr install  <应用名> [文件] [选项]                    # 安装或更新 (无文件=自动下载)
  opt-mgr remove   <应用名> [--keep-conf]                    # 卸载, --keep-conf 保留配置
  opt-mgr conf     <应用名> --repo owner/repo [选项]         # 仅创建配置, 不安装
  opt-mgr list                                               # 查看所有已管理应用
  opt-mgr info     <应用名>                                  # 查看应用详情 + 远端对比
  opt-mgr check    [应用名]                                  # 检查更新 (不填=全部)
  opt-mgr upgrade  [应用名]                                  # 升级 (不填=全部)
  opt-mgr build    <应用名> [--repo] [--type 类型] [选项]    # 构建 COPR RPM, --type 可覆盖 .conf
  opt-mgr set-repo <应用名> <owner/repo> [asset匹配]         # 配置仓库 (位置参数)
  opt-mgr skip     <应用名>                                  # 从批量升级中排除
  opt-mgr unskip   <应用名>                                  # 恢复批量升级
  opt-mgr rollback <应用名>                                  # 回退到上一版本
  opt-mgr clean    all | <应用名>...                         # 清理回退备份

install / conf / build 公用选项:

  --repo <owner/repo>                                        # GitHub 仓库
  --type <tar|jar|appimage>                                  # 文件类型
  --pattern <模式>                                           # asset 匹配 (自动按架构识别)
  --icon <路径|URL>                                          # 图标 (支持本地文件和 GitHub raw URL)
  --exec <前缀>                                              # Exec 命令, {} 占位 (仅 install/build)

install 选项:

  --icon <路径>                                              # 指定图标文件
  --exec <前缀>                                              # Exec前缀, {} 占位二进制路径
  --repo <owner/repo>                                        # GitHub 仓库 (首次配置后自动检查更新)
  --pattern <模式>                                           # asset 匹配模式 (可选, 自动按架构识别)

支持的文件类型:

  .tar.gz / .tgz                                             # 解压到 /opt/<应用名>/
  .jar                                                       # java -jar 启动
  .rpm                                                       # dnf 系统安装
  .AppImage                                                  # 复制到 /opt/<应用名>/ 直接执行
  其他二进制文件                                             # 同上

示例:

  opt-mgr install kazumi ~/Downloads/Kazumi_2.1.8_amd64.tar.gz \
    --repo Predidit/Kazumi
  opt-mgr install hmcl ~/Downloads/HMCL-3.15.1.jar \
    --repo HMCL-dev/HMCL --icon ~/Downloads/hmcl.png \
    --exec 'java -Dglass.gtk.uiScale=1.5 -jar {}'
  opt-mgr install splayer ~/Downloads/splayer-3.1.1-x86_64.rpm \
    --repo SPlayer-Dev/SPlayer
EOF
    exit 1
}

init_conf() { mkdir -p "$CONF_DIR"; }

resolve_app() {
    local name="$1"
    for conf in "$CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        local app=$(basename "$conf" .conf)
        if [ "${app,,}" = "${name,,}" ]; then
            echo "$app"
            return 0
        fi
    done
    echo "$name"
    return 1
}

opt_dir() {
    local d=$(get_conf "$1" "opt_dir")
    echo "${d:-/opt/$1}"
}

get_conf() {
    local file="$CONF_DIR/${1}.conf" key="$2"
    [ -f "$file" ] && grep "^${key}=" "$file" 2>/dev/null | cut -d= -f2- || echo ""
}

set_conf() {
    local app="$1" key="$2" value="$3"
    local file="$CONF_DIR/${app}.conf"
    touch "$file"
    if grep -q "^${key}=" "$file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
    else
        echo "${key}=${value}" >> "$file"
    fi
}

find_binary() {
    local dir="$1" hint="$2"
    if [ -n "$hint" ] && [ -f "$dir/$hint" ] && [ -x "$dir/$hint" ]; then echo "$hint"; return; fi
    # 优先匹配应用名（大小写不敏感）
    local found
    found=$(find "$dir" -maxdepth 2 -type f -executable -not -path "*/data/*" -not -path "*/lib/*" \
        -iname "$hint" | grep -v '\.so' | head -1)
    [ -n "$found" ] && basename "$found" && return
    # 其次任意可执行文件
    found=$(find "$dir" -maxdepth 2 -type f -executable -not -path "*/data/*" -not -path "*/lib/*" \
        | grep -v '\.so' | grep -v 'chrome_crashpad\|chrome-sandbox' | head -1)
    [ -n "$found" ] && basename "$found" && return
    echo "$hint"
}

find_icon_in_dir() {
    find "$1" -maxdepth 6 \( -name "*.png" -o -name "*.svg" \) \
        ! -path "*/data/*" ! -path "*/lib/*" ! -path "*node_modules*" \
        2>/dev/null | xargs ls -1S 2>/dev/null | head -1 | sed "s|^$1/||"
}

detect_arch() {
    local a=$(uname -m)
    case "$a" in
        x86_64) echo "x86_64 amd64" ;;
        aarch64) echo "aarch64 arm64" ;;
        *) echo "$a" ;;
    esac
}

default_pattern() {
    local ftype="$1"
    local archs=($(detect_arch))
    case "$ftype" in
        rpm)    echo "*${archs[0]}.rpm" ;;
        tar)    echo "*linux_*.tar.gz" ;;
        appimage) echo "*.AppImage" ;;
        jar)    echo "*.jar" ;;
        *)      echo "*" ;;
    esac
}

detect_file_type() {
    case "$1" in
        *.tar.gz|*.tgz) echo "tar" ;;
        *.jar)           echo "jar" ;;
        *.rpm)           echo "rpm" ;;
        *.AppImage)      echo "appimage" ;;
        *)               echo "file" ;;
    esac
}

create_desktop() {
    local app="$1" exec_cmd="$2" icon="$3" comment="$4"
    local desktop_file="$HOME/.local/share/applications/${app}.desktop"
    mkdir -p "$HOME/.local/share/applications"
    local icon_line=""
    [ -n "$icon" ] && icon_line="Icon=${icon}"
    cat > "$desktop_file" <<DESKTOP
[Desktop Entry]
Name=${app^}
Comment=${comment}
Exec=${exec_cmd}
${icon_line}
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=${app^}
DESKTOP
    echo "  桌面快捷方式已创建: $desktop_file"
}

# 解析图标：本地文件、相对路径或 URL，返回本地文件路径
resolve_icon() {
    local src="$1" dest_dir="$2" app="$3" repo="${4:-}"
    if [ -z "$src" ]; then
        return 1
    fi
    # 相对路径 → 拼接 GitHub raw URL
    if [[ "$src" != http* ]] && [[ "$src" != /* ]] && [ -n "$repo" ]; then
        src="https://raw.githubusercontent.com/${repo}/main/${src#/}"
    fi
    if [[ "$src" != http* ]] && [ ! -f "$src" ]; then
        return 1
    fi
    local ext name dest
    if [[ "$src" =~ ^https?:// ]]; then
        ext="${src##*.}"; ext="${ext%%\?*}"
        [ "${#ext}" -gt 5 ] && ext="png"
        name="${app}-icon.${ext}"
        dest="${dest_dir}/${name}"
        >&2 echo "  下载图标: $src"
        download_file "$src" "$dest" >&2 2>&1 || { >&2 echo "  错误: 图标下载失败"; return 1; }
        # 检查是否为 HTML 错误页
        if head -c1 "$dest" 2>/dev/null | grep -q '<\|{'; then
            >&2 echo "  错误: 图标文件无效 (可能是404)"
            rm -f "$dest"
            return 1
        fi
        echo "$dest"
    elif [ -f "$src" ]; then
        ext="${src##*.}"
        name="${app}-icon.${ext}"
        dest="${dest_dir}/${name}"
        cp "$src" "$dest"
        echo "$dest"
    fi
}

# ---------- install ----------
cmd_install() {
    [ $# -ge 1 ] || usage
    local app="$1"
    shift

    # 如果第二个参数不是文件路径，视为选项解析（无文件参数）
    local file=""
    if [ $# -gt 0 ] && [ -f "$1" ] && [[ ! "$1" =~ ^-- ]]; then
        file="$1"; shift
    fi

    local icon_opt="" exec_prefix="" repo="" pattern="" app_type="" local_only=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --icon)    icon_opt="$2"; shift ;;
            --exec)    exec_prefix="$2"; shift ;;
            --repo)    repo="$2"; shift ;;
            --pattern) pattern="$2"; shift ;;
            --type)    app_type="$2"; shift ;;
            --local)   local_only=true ;;
            *) echo "未知选项: $1"; exit 1 ;;
        esac
        shift
    done

    # 纯本地安装：跳过仓库配置和 .conf 创建
    if $local_only && [ -n "$file" ]; then
        local target_dir="/opt/$app"
        local ftype=$(detect_file_type "$file")
        local name=$(basename "$file")
        echo "===== 本地安装 $app (类型: $ftype) ====="
        sudo mkdir -p "$target_dir"
        case "$ftype" in
            tar)
                local unique=$(tar -tzf "$file" | cut -d/ -f1 | sort -u | wc -l)
                local strip=""; [ "$unique" -eq 1 ] && strip="--strip-components=1"
                sudo tar -xzf "$file" -C "$target_dir" $strip --no-same-permissions
                local binary=$(find_binary "$target_dir" "$app")
                sudo chmod +x "$target_dir/$binary"
                create_desktop "$app" "${target_dir}/$binary" "$(find_icon_in_dir "$target_dir")" "${app^} 应用"
                ;;
            jar|appimage|file)
                sudo cp "$file" "${target_dir}/$name"
                [ "$ftype" != "jar" ] && sudo chmod +x "${target_dir}/$name"
                local exec_cmd="${target_dir}/$name"
                [ "$ftype" = "jar" ] && exec_cmd="java -jar ${target_dir}/$name"
                create_desktop "$app" "$exec_cmd" "" "${app^} 应用"
                ;;
        esac
        echo "===== 本地安装完成 (无仓库配置) ====="
        return
    fi
    $local_only && { echo "错误: --local 需要提供安装文件"; exit 1; }

    local target_dir="/opt/$app"
    local real_dir=$(opt_dir "$app")
    if [ -d "$real_dir" ] && [ -n "$repo" ] && [ -z "$file" ]; then
        local existing_binary=$(get_conf "$app" "binary")
        if [ -n "$existing_binary" ] && [ -f "$real_dir/$existing_binary" ]; then
            # 已有安装 + --repo + 无文件 → 仅补仓库信息
            init_conf
            set_conf "$app" "opt_dir" "$real_dir"
            set_conf "$app" "repo" "$repo"
            local existing_pat=$(get_conf "$app" "asset_pattern")
            if [ -n "$pattern" ]; then
                set_conf "$app" "asset_pattern" "$pattern"
            elif [ -z "$existing_pat" ] || [ "$existing_pat" = "*" ]; then
                set_conf "$app" "asset_pattern" "$(default_pattern "$(get_conf "$app" "type")")"
            fi
            local ver=$(get_conf "$app" "binary" | grep -oP '[\d]+\.[\d]+(\.[\d]+)?' | head -1)
            [ -n "$ver" ] && set_conf "$app" "version" "$ver"
            [ -z "$(get_conf "$app" "type")" ] && set_conf "$app" "type" "$(detect_file_type "$existing_binary")"
            echo "已为 $app 配置 GitHub 仓库: $repo"
            return
        fi
    fi

    # 已存在则走更新
    if [ -d "$real_dir" ] && [ -n "$file" ]; then
        echo "应用已存在, 执行更新..."
        cmd_update "$app" "$file"
        [ -n "$repo" ] && set_conf "$app" "repo" "$repo"
        return
    fi

    # 无文件 + 有仓库 → 自动下载
    if [ -z "$file" ]; then
        [ -z "$repo" ] && repo=$(get_conf "$app" "repo")
        [ -z "$repo" ] && { echo "错误: 需要文件路径或 --repo 配置"; exit 1; }
        echo "===== 自动下载 $app ====="
        local json=$(gh_api_latest "$repo")
        local api_rc=$?
        if [ $api_rc -ne 0 ]; then
            [ $api_rc -ne 2 ] && echo "错误: 请求 GitHub API 失败"
            exit 1
        fi
        local conf_type=$(get_conf "$app" "type")
        [ -z "$app_type" ] && app_type="$conf_type"
        local pat=$(get_conf "$app" "asset_pattern")
        pat="${pat:-$(default_pattern "$app_type")}"
        if [ -z "$app_type" ] && [ -z "$(get_conf "$app" "asset_pattern")" ]; then
            >&2 echo "提示: 未指定类型和匹配模式，将下载匹配的第一个文件"
            >&2 echo "      建议: install 时加 --type jar|tar|appimage 和 --pattern '模式'"
            >&2 echo "      或在 conf 中设置 type= 和 asset_pattern="
        fi
        local latest_tag=$(gh_tag_name "$json")
        local latest_ver=$(extract_version "$latest_tag")
        local current_ver=$(get_conf "$app" "version")
        local target_dir=$(opt_dir "$app")
        if [ -d "$target_dir" ] && [ -n "$current_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
            echo "已是最新版本 ($current_ver)"
            return 0
        fi
        local download_url asset_name
        download_url=$(match_asset "$json" "$pat" url)
        asset_name=$(match_asset "$json" "$pat" name)
        [ -z "$download_url" ] && { echo "错误: 未匹配到下载文件"; exit 1; }
        echo "下载: $asset_name"
        local tmp_dir="$HOME/.cache/opt-mgr/downloads"
        mkdir -p "$tmp_dir"
        file="$tmp_dir/$asset_name"
        download_file "$download_url" "$file" || { echo "错误: 下载失败"; rm -f "$file"; exit 1; }
        echo ""
    fi

    # 已存在则走更新
    if [ -d "$real_dir" ]; then
        echo "应用已存在, 执行更新..."
        cmd_update "$app" "$file"
        [ -n "$repo" ] && set_conf "$app" "repo" "$repo"
        return
    fi

    local ftype=$(detect_file_type "$file")
    local name=$(basename "$file")

    init_conf

    echo "===== 安装 $app (类型: $ftype) ====="
    sudo mkdir -p "$target_dir"

    local binary="" exec_cmd="" icon=""

    case "$ftype" in
        tar)
            local strip_flag=""
            local unique
            unique=$(tar -tzf "$file" | cut -d/ -f1 | sort -u | wc -l)
            [ "$unique" -eq 1 ] && strip_flag="--strip-components=1"
            sudo tar -xzf "$file" -C "$target_dir" $strip_flag --no-same-permissions
            echo "  -> 已解压到 $target_dir"

            binary=$(find_binary "$target_dir" "$app")
            sudo chmod +x "$target_dir/$binary"
            echo "  -> 可执行文件: $binary"

            if [ -n "$exec_prefix" ]; then
                exec_cmd="${exec_prefix/\{\}/\"${target_dir}/$binary\"}"
            else
                exec_cmd="${target_dir}/$binary"
            fi

            set_conf "$app" "type" "tar"
            set_conf "$app" "binary" "$binary"

            if [ -n "$icon_opt" ]; then
                local resolved=$(resolve_icon "$icon_opt" "/tmp" "$app" "$repo")
                if [ -n "$resolved" ]; then
                    local icon_name=$(basename "$resolved")
                    sudo cp "$resolved" "${target_dir}/$icon_name"
                    icon="${target_dir}/$icon_name"
                    rm -f "$resolved"
                fi
            fi
            if [ -z "$icon" ]; then
                icon=$(find_icon_in_dir "$target_dir")
                [ -n "$icon" ] && icon="${target_dir}/$icon"
            fi
            ;;

        jar)
            binary="$name"
            sudo cp "$file" "${target_dir}/$name"
            echo "  -> 已复制: $name"

            if [ -n "$exec_prefix" ]; then
                exec_cmd="${exec_prefix/\{\}/\"${target_dir}/$name\"}"
            else
                exec_cmd="java -jar ${target_dir}/$name"
            fi
            echo "  -> Exec: $exec_cmd"

            set_conf "$app" "type" "jar"
            set_conf "$app" "binary" "$binary"

            if [ -n "$icon_opt" ]; then
                local resolved=$(resolve_icon "$icon_opt" "/tmp" "$app" "$repo")
                if [ -n "$resolved" ]; then
                    local icon_name=$(basename "$resolved")
                    sudo cp "$resolved" "${target_dir}/$icon_name"
                    icon="${target_dir}/$icon_name"
                    rm -f "$resolved"
                fi
            fi
            ;;

        appimage|file)
            binary="$name"
            sudo cp "$file" "${target_dir}/$name"
            sudo chmod +x "${target_dir}/$name"
            echo "  -> 已复制: $name"

            if [ -n "$exec_prefix" ]; then
                exec_cmd="${exec_prefix/\{\}/\"${target_dir}/$name\"}"
            else
                exec_cmd="${target_dir}/$name"
            fi

            set_conf "$app" "type" "$ftype"
            set_conf "$app" "binary" "$binary"

            if [ -n "$icon_opt" ]; then
                local resolved=$(resolve_icon "$icon_opt" "/tmp" "$app" "$repo")
                if [ -n "$resolved" ]; then
                    local icon_name=$(basename "$resolved")
                    sudo cp "$resolved" "${target_dir}/$icon_name"
                    icon="${target_dir}/$icon_name"
                    rm -f "$resolved"
                fi
            fi
            ;;

        rpm)
            binary="$name"
            echo "  -> 安装 RPM: $name"
            if command -v dnf5 &>/dev/null || dnf --version 2>/dev/null | grep -q "dnf5"; then
                sudo dnf install -y "$file"
            else
                sudo dnf install -y "$file" 2>/dev/null || sudo rpm -U "$file"
            fi
            init_conf
            set_conf "$app" "type" "rpm"
            set_conf "$app" "binary" "$binary"
            ;;

    esac

    if [ "$ftype" = "rpm" ]; then
        set_conf "$app" "opt_dir" ""

        if [ -n "$repo" ]; then
            set_conf "$app" "repo" "$repo"
            local pat="${pattern:-$(default_pattern "$ftype")}"
            set_conf "$app" "asset_pattern" "$pat"
            local ver=$(echo "$binary" | grep -oP '[\d]+\.[\d]+(\.[\d]+)?' | head -1)
            [ -n "$ver" ] && set_conf "$app" "version" "$ver"
            echo "  -> GitHub: $repo  (asset: ${pattern:-*})"
        fi

        echo "===== 安装完成 ====="
        return
    fi

    [ -n "$exec_cmd" ] && set_conf "$app" "exec" "$exec_cmd"
    [ -n "$icon" ] && set_conf "$app" "icon" "$icon"
    set_conf "$app" "opt_dir" "$target_dir"

    if [ -n "$repo" ]; then
        set_conf "$app" "repo" "$repo"
        local pat="${pattern:-$(default_pattern "$ftype")}"
        set_conf "$app" "asset_pattern" "$pat"
        local ver=$(echo "$file" | grep -oP '[\d]+\.[\d]+(\.[\d]+)?' | head -1)
        [ -n "$ver" ] && set_conf "$app" "version" "$ver"
        echo "  -> GitHub: $repo  (asset: ${pattern:-*})"
    fi

    create_desktop "$app" "$exec_cmd" "$icon" "${app^} 应用"
    echo "===== 安装完成 ====="
}

# ---------- update ----------
cmd_update() {
    local app_input="$1" file="${2:-}"

    local app=$(resolve_app "$app_input")
    local target_dir=$(opt_dir "$app")

    # 无文件参数 → 自动从 GitHub 下载最新版
    if [ -z "$file" ]; then
        local repo=$(get_conf "$app" "repo")
        [ -z "$repo" ] && { echo "错误: $app 未配置 GitHub 仓库, 请提供文件路径或先执行 set-repo"; exit 1; }

        echo "===== 自动更新 $app ====="
        local json
        json=$(gh_api_latest "$repo")
        local api_rc=$?
        if [ $api_rc -ne 0 ]; then
            [ $api_rc -ne 2 ] && echo "错误: 请求 GitHub API 失败"
            exit 1
        fi

        local latest_tag=$(gh_tag_name "$json")
        local app_type=$(get_conf "$app" "type")
        local pattern=$(get_conf "$app" "asset_pattern")
        pattern="${pattern:-$(default_pattern "$app_type")}"
        local current_ver=$(get_conf "$app" "version")

        local download_url asset_name
        download_url=$(match_asset "$json" "$pattern" url)
        asset_name=$(match_asset "$json" "$pattern" name)

        if [ -z "$download_url" ]; then
            echo "错误: 未匹配到合适的下载文件"
            exit 1
        fi

        local latest_ver=$(extract_version "$latest_tag")
        [ -n "$current_ver" ] && [ "$current_ver" = "$latest_ver" ] && { echo "已是最新版本 ($current_ver)"; return 0; }

        echo "下载: $asset_name  ($latest_ver)"
        local tmp_dir="$HOME/.cache/opt-mgr/downloads"
        mkdir -p "$tmp_dir"
        file="$tmp_dir/$asset_name"
        download_file "$download_url" "$file" || { echo "错误: 下载失败"; rm -f "$file"; exit 1; }
        echo ""
    fi

    [ -f "$file" ] || { echo "错误: 找不到文件 $file"; exit 1; }

    local app_type=$(get_conf "$app" "type")
    [ "$app_type" = "rpm" ] || [ -d "$target_dir" ] || { echo "错误: $target_dir 不存在，请先使用 install"; exit 1; }

    local old_binary=$(get_conf "$app" "binary")
    local old_exec=$(get_conf "$app" "exec")
    local old_icon=$(get_conf "$app" "icon")
    local name=$(basename "$file")
    local ftype=$(detect_file_type "$file")

    local backup_dir="$HOME/.cache/opt-mgr/backups/$app"
    local current_ver=$(get_conf "$app" "version")
    mkdir -p "$backup_dir"
    echo "$current_ver" > "$backup_dir/prev_version"
    get_conf "$app" "exec" > "$backup_dir/prev_exec"
    get_conf "$app" "binary" > "$backup_dir/prev_binary"
    get_conf "$app" "icon" > "$backup_dir/prev_icon"

    case "$ftype" in
        tar)
            [ -d "$target_dir" ] && sudo tar -czf "$backup_dir/prev.tar.gz" -C "$(dirname "$target_dir")" "$(basename "$target_dir")" 2>/dev/null
            local strip_flag=""
            local unique
            unique=$(tar -tzf "$file" | cut -d/ -f1 | sort -u | wc -l)
            [ "$unique" -eq 1 ] && strip_flag="--strip-components=1"
            sudo tar -xzf "$file" -C "$target_dir" $strip_flag --no-same-permissions --overwrite

            binary=$(get_conf "$app" "binary")
            [ ! -f "${target_dir}/$binary" ] && binary=$(find_binary "$target_dir" "$app")
            sudo chmod +x "${target_dir}/$binary"

            exec_cmd=$(get_conf "$app" "exec")
            if [ -z "$exec_cmd" ]; then
                exec_cmd="${target_dir}/$binary"
            elif echo "$exec_cmd" | grep -q "{}"; then
                exec_cmd="${exec_cmd/\{\}/\"${target_dir}/$binary\"}"
            elif [ -n "$old_binary" ]; then
                exec_cmd="${exec_cmd//${old_binary}/${binary}}"
            fi

            set_conf "$app" "binary" "$binary"
            set_conf "$app" "type" "tar"

            icon=$(find_icon_in_dir "$target_dir")
            [ -n "$icon" ] && icon="${target_dir}/$icon"
            ;;

        jar|appimage|file)
            # 备份旧文件
            [ -f "${target_dir}/$old_binary" ] && cp "${target_dir}/$old_binary" "$backup_dir/prev" 2>/dev/null
            binary="$name"
            if [ -n "$old_binary" ] && [ -f "${target_dir}/$old_binary" ] && [ "$old_binary" != "$binary" ]; then
                sudo rm -f "${target_dir}/$old_binary"
            fi
            sudo cp "$file" "${target_dir}/$name"
            [ "$ftype" != "jar" ] && sudo chmod +x "${target_dir}/$name"

            exec_cmd=$(get_conf "$app" "exec")
            if [ -n "$exec_cmd" ] && echo "$exec_cmd" | grep -q "{}"; then
                exec_cmd="${exec_cmd/\{\}/\"${target_dir}/$name\"}"
            elif [ -n "$old_binary" ] && [ -n "$exec_cmd" ]; then
                exec_cmd="${exec_cmd//${old_binary}/${name}}"
            else
                [ "$ftype" = "jar" ] && exec_cmd="java -jar ${target_dir}/$name" || exec_cmd="${target_dir}/$name"
            fi

            set_conf "$app" "binary" "$binary"
            set_conf "$app" "type" "$ftype"
            ;;

        rpm)
            binary="$name"
            if command -v dnf5 &>/dev/null || dnf --version 2>/dev/null | grep -q "dnf5"; then
                sudo dnf install -y "$file"
            else
                sudo dnf install -y "$file" 2>/dev/null || sudo rpm -U "$file"
            fi
            set_conf "$app" "binary" "$binary"
            set_conf "$app" "type" "rpm"
            return
            ;;
    esac

    if [ -z "$icon" ]; then
        icon="$old_icon"
    fi

    [ -n "$exec_cmd" ] && set_conf "$app" "exec" "$exec_cmd"
    [ -n "$icon" ] && set_conf "$app" "icon" "$icon"

    create_desktop "$app" "$exec_cmd" "$icon" "${app^} 应用"
}

# ---------- remove ----------
cmd_remove() {
    local app=$(resolve_app "$1")
    shift
    local keep_conf=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --keep-conf) keep_conf=true ;;
            *) shift; continue ;;
        esac
        shift
    done

    local target_dir=$(opt_dir "$app")
    local app_type=$(get_conf "$app" "type")

    echo "===== 卸载 $app ====="
    if [ "$app_type" = "rpm" ]; then
        local pkg=$(rpm -qf "$(get_conf "$app" "binary" 2>/dev/null || echo "")" 2>/dev/null)
        [ -n "$pkg" ] && sudo dnf remove -y "$pkg" 2>/dev/null
        rm -f "$HOME/.local/share/applications/${app}.desktop"
        $keep_conf || rm -f "$CONF_DIR/${app}.conf"
    else
        [ -d "$target_dir" ] || { echo "错误: $target_dir 不存在"; exit 1; }
        sudo rm -rf "$target_dir"
        rm -f "$HOME/.local/share/applications/${app}.desktop"
        $keep_conf || rm -f "$CONF_DIR/${app}.conf"
    fi
    $keep_conf && echo "  已保留配置: $CONF_DIR/${app}.conf"
    echo "===== 卸载完成 ====="
}

# ---------- list ----------
cmd_list() {
    echo "已管理的应用:"
    local found=0 installed=0 configured=0
    for conf in "$CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        local app=$(basename "$conf" .conf)
        local app_type=$(get_conf "$app" "type")
        local binary=$(get_conf "$app" "binary")
        local target_dir=$(opt_dir "$app")
        local ver=$(get_conf "$app" "version")
        local repo=$(get_conf "$app" "repo")
        local skip=$(get_conf "$app" "skip")

        local status_icon="○" status_text="仅配置"
        if [ -n "$binary" ] && [ -f "$target_dir/$binary" ]; then
            status_icon="●"; status_text="已安装"
        elif [ "$app_type" = "rpm" ] && [ -n "$binary" ] && rpm -q "${binary%%.rpm}" &>/dev/null 2>&1; then
            status_icon="●"; status_text="已安装(rpm)"
        fi

        echo "  $status_icon $app  ($status_text)"
        echo "    版本:    ${ver:-未知}  |  类型: ${app_type:-未知}"
        echo "    路径:    ${target_dir:-无}"
        [ -n "$repo" ] && echo "    GitHub:  $repo"
        [ "$skip" = "1" ] && echo "    批量升级: 已排除"
        found=1
        [ "$status_text" = "仅配置" ] && configured=$((configured+1)) || installed=$((installed+1))
    done
    [ $found -eq 0 ] && echo "  (无)"
    echo ""
    echo "  $installed 个已安装, $configured 个仅配置"
}

# ---------- set-repo ----------
cmd_set_repo() {
    [ $# -ge 2 ] || { echo "用法: opt-mgr set-repo <应用名> <owner/repo> [asset匹配模式]"; exit 1; }
    [[ "$1" == -* ]] && { echo "错误: set-repo 第一个参数应为应用名，不是选项"; exit 1; }
    local app=$(resolve_app "$1"); shift
    local repo="${1:-}" pattern="${2:-}"
    [ -n "$repo" ] || { echo "用法: opt-mgr set-repo <应用名> <owner/repo> [asset匹配模式]"; exit 1; }
    [ -f "$CONF_DIR/${app}.conf" ] || { echo "错误: $app 未通过 opt-mgr 管理"; exit 1; }

    set_conf "$app" "repo" "$repo"
    if [ -n "$pattern" ]; then
        set_conf "$app" "asset_pattern" "$pattern"
    else
        local existing_pat=$(get_conf "$app" "asset_pattern")
        if [ -z "$existing_pat" ] || [ "$existing_pat" = "*" ]; then
            set_conf "$app" "asset_pattern" "$(default_pattern "$(get_conf "$app" "type")")"
        fi
    fi

    local binary=$(get_conf "$app" "binary")
    local ver=$(echo "$binary" | grep -oP '[\d]+\.[\d]+(\.[\d]+)?' | head -1)
    [ -n "$ver" ] && set_conf "$app" "version" "$ver"

    echo "已配置 $app GitHub 仓库: $repo"
    echo "  asset 匹配: ${pattern:-*}"
    echo "  当前版本:   ${ver:-未知}"
}

# ---------- 辅助: JSON 解析 ----------
gh_tag_name()    { echo "$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tag_name',''))" 2>/dev/null; }
gh_published()   { echo "$1" | python3 -c "import sys,json; print(json.load(sys.stdin).get('published_at','')[:10])" 2>/dev/null; }

match_asset() {
    # 用法: match_asset <json> <pattern> <mode>
    # mode=url  → 输出下载链接, mode=name → 输出文件名
    local json="$1" pattern="$2" mode="${3:-url}"
    echo "$json" | python3 -c "
import sys, json, fnmatch
data = json.load(sys.stdin)
for a in data.get('assets', []):
    if fnmatch.fnmatch(a['name'], '$pattern'):
        print(a['browser_download_url'] if '$mode' == 'url' else a['name'])
        break
" 2>/dev/null
}

# ---------- GitHub API ----------
gh_api_latest() {
    local repo="$1"
    local token="${GITHUB_TOKEN:-}"
    [ -z "$token" ] && [ -f "$HOME/.config/opt-mgr/github_token" ] && token=$(cat "$HOME/.config/opt-mgr/github_token")

    local cache_file="$HOME/.cache/opt-mgr/api_cache_$(echo "$repo" | tr '/' '_')"
    mkdir -p "$HOME/.cache/opt-mgr"

    if [ -f "$cache_file" ] && [ $(($(date +%s) - $(stat -c %Y "$cache_file"))) -lt 300 ]; then
        cat "$cache_file"
        return
    fi

    local tmp_resp=$(mktemp /tmp/opt-mgr-gh-resp.XXXXXX)
    local http_code
    if [ -n "$token" ]; then
        http_code=$(curl -sL -o "$tmp_resp" -w '%{http_code}' \
            -H "Authorization: Bearer $token" \
            "https://api.github.com/repos/${repo}/releases/latest")
    else
        http_code=$(curl -sL -o "$tmp_resp" -w '%{http_code}' \
            "https://api.github.com/repos/${repo}/releases/latest")
    fi
    local data=$(cat "$tmp_resp" 2>/dev/null)
    rm -f "$tmp_resp"

    if [ "$http_code" = "403" ] && echo "$data" | grep -qi "rate limit"; then
            touch "$HOME/.cache/opt-mgr/rate_limited"
            return 2
    fi

    if [ -n "$data" ] && [ "$http_code" = "200" ]; then
        echo "$data" | tee "$cache_file"
    else
        return 1
    fi
}

download_file() {
    local url="$1" dest="$2"
    if command -v wget &>/dev/null; then
        wget -q --show-progress -O "$dest" "$url"
    elif command -v aria2c &>/dev/null; then
        aria2c -q --console-log-level=error --show-console-readout=true -o "$dest" "$url"
    else
        curl -fSL --progress-bar -o "$dest" "$url"
    fi
}

extract_version() {
    echo "$1" | grep -oP '[\d]+\.[\d]+(\.[\d]+)?' | head -1
}

# ---------- check ----------
cmd_check() {
    local target="${1:-}"
    [ -z "$target" ] && echo "===== 检查所有应用更新 ====="
    local checked=0 updated=0

    for conf in "$CONF_DIR"/*.conf; do
        [ -f "$conf" ] || continue
        local app=$(basename "$conf" .conf)
        [ -n "$target" ] && [ "${app,,}" != "${target,,}" ] && continue

        local repo=$(get_conf "$app" "repo")
        [ -z "$repo" ] && continue

        local current_ver=$(get_conf "$app" "version")
        local app_type=$(get_conf "$app" "type")
        local pattern=$(get_conf "$app" "asset_pattern")
        pattern="${pattern:-$(default_pattern "$app_type")}"

        echo ""
        echo "[$app] 仓库: $repo"

        local json
        json=$(gh_api_latest "$repo")
        local api_rc=$?
        if [ $api_rc -ne 0 ]; then
            [ $api_rc -ne 2 ] && echo "    ⚠ 请求失败"
            continue
        fi

        local latest_tag=$(gh_tag_name "$json")
        local latest_ver=$(extract_version "$latest_tag")
        local published=$(gh_published "$json")

        if [ -z "$latest_ver" ]; then
            echo "    ⚠ 无法解析远端版本号 (tag: $latest_tag)"
            continue
        fi

        local asset_name=""
        if [ -n "$pattern" ]; then
            asset_name=$(match_asset "$json" "$pattern" name)
        fi

        echo "    远程版本: $latest_ver ($published)"
        echo "    本地版本: ${current_ver:-未知}"
        [ -n "$asset_name" ] && echo "    匹配资产: $asset_name"

        if [ -n "$current_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
            echo "    ✓ 已是最新"
        elif [ -n "$current_ver" ]; then
            echo "    ✦ 有新版本可用!"
            updated=$((updated + 1))
        else
            echo "    ✦ 有新版本可用 (本地版本未记录)"
            updated=$((updated + 1))
        fi
        checked=$((checked + 1))
    done

    echo ""
    echo "检查完成: $checked 个应用, $updated 个有新版本"
    check_rate_limit
}
# ---------- upgrade ----------
cmd_upgrade() {
    local target="${1:-}"


    if [ -z "$target" ]; then
        local apps=()
        for conf in "$CONF_DIR"/*.conf; do
            [ -f "$conf" ] || continue
            local app=$(basename "$conf" .conf)
            local repo=$(get_conf "$app" "repo")
            local skip=$(get_conf "$app" "skip")
            [ -n "$repo" ] && [ "$skip" != "1" ] && apps+=("$app")
        done

        local total=${#apps[@]}
        [ "$total" -eq 0 ] && { echo "无配置 GitHub 仓库的应用。"; return; }

        echo "升级第三方应用:"
        local upgraded=0 failed=0 idx=0
        for app in "${apps[@]}"; do
            idx=$((idx + 1))
            local rc=0
            do_upgrade_one "$app" "$idx" "$total" || rc=$?
            case $rc in
                0) upgraded=$((upgraded + 1)) ;;
                1) failed=$((failed + 1)) ;; 
    esac
        done
        [ $upgraded -eq 0 ] && [ $failed -eq 0 ] && echo "无须任何处理。"
        [ $failed -gt 0 ] && echo "完成: $upgraded 成功, $failed 失败"
        check_rate_limit
        return
    fi

    local app=$(resolve_app "$target")
    echo "升级第三方应用:"
    local rc
    do_upgrade_one "$app" 1 1
    rc=$?
    [ $rc -eq 2 ] && echo "$app: 无须任何处理。"
}

do_upgrade_one() {
    local app="$1" idx="${2:-1}" total="${3:-1}"
    local repo=$(get_conf "$app" "repo")
    [ -z "$repo" ] && return 1

    local target_dir=$(opt_dir "$app")
    local app_type=$(get_conf "$app" "type")
    if [ "$app_type" != "rpm" ] && [ ! -d "$target_dir" ]; then
        echo "[$idx/$total] $app: 目录不存在, 跳过"
        return 1
    fi

    local json
    json=$(gh_api_latest "$repo")
    local api_rc=$?
    if [ $api_rc -ne 0 ]; then
        [ $api_rc -ne 2 ] && echo "[$idx/$total] $app: API 请求失败"
        return 1
    fi

    local latest_tag=$(gh_tag_name "$json")
    local latest_ver=$(extract_version "$latest_tag")
    local current_ver=$(get_conf "$app" "version")
    local pattern=$(get_conf "$app" "asset_pattern")
    pattern="${pattern:-$(default_pattern "$app_type")}"

    if [ -n "$current_ver" ] && [ "$current_ver" = "$latest_ver" ]; then
        return 2
    fi

    local download_url asset_name
    download_url=$(match_asset "$json" "$pattern" url)
    asset_name=$(match_asset "$json" "$pattern" name)

    if [ -z "$download_url" ]; then
        echo "[$idx/$total] $app: 未匹配到下载文件"
        return 1
    fi

    local ver_info=""
    [ -n "$current_ver" ] && ver_info="  正在升级:  $current_ver → $latest_ver"
    echo "[$idx/$total] $app:$ver_info"

    local tmp_dir="$HOME/.cache/opt-mgr/downloads"
    mkdir -p "$tmp_dir"
    local local_file="$tmp_dir/$asset_name"
    download_file "$download_url" "$local_file" || {
        echo "[$idx/$total] $app: 下载失败"; rm -f "$local_file"; return 1
    }

    if cmd_update "$app" "$local_file"; then
        set_conf "$app" "version" "$latest_ver"
        return 0
    else
        echo "[$idx/$total] $app: 安装失败"
        return 1
    fi
}

check_rate_limit() {
    if [ -f "$HOME/.cache/opt-mgr/rate_limited" ]; then
        rm -f "$HOME/.cache/opt-mgr/rate_limited"
        cat >&2 <<EOF

⚠  GitHub API 限流 (60次/小时), 请配置 Token:
  1. 访问 https://github.com/settings/tokens?type=beta 创建 Token
  2. 权限无需勾选, 直接 Generate
  3. echo "你的Token" > ~/.config/opt-mgr/github_token
EOF
    fi
}

# ---------- rollback ----------
cmd_rollback() {
    local app=$(resolve_app "${1:-}")
    [ -z "$app" ] && { echo "用法: opt-mgr rollback <应用名>"; exit 1; }

    local backup_dir="$HOME/.cache/opt-mgr/backups/$app"
    [ ! -d "$backup_dir" ] && { echo "$app: 没有可回退的版本"; exit 1; }

    local prev_ver=$(cat "$backup_dir/prev_version" 2>/dev/null || echo "?")
    local current_ver=$(get_conf "$app" "version")
    echo "$app: $current_ver → $prev_ver"

    local app_type=$(get_conf "$app" "type")
    local target_dir=$(opt_dir "$app")

    case "$app_type" in
        tar)
            [ ! -f "$backup_dir/prev.tar.gz" ] && { echo "$app: 备份文件不存在"; exit 1; }
            sudo rm -rf "${target_dir:?}/*"
            sudo tar -xzf "$backup_dir/prev.tar.gz" -C "$(dirname "$target_dir")"
            echo "  目录已还原"
            ;;
        jar|appimage|file)
            [ ! -f "$backup_dir/prev" ] && { echo "$app: 备份文件不存在"; exit 1; }
            prev_binary=$(cat "$backup_dir/prev_binary" 2>/dev/null || echo "")
            sudo cp "$backup_dir/prev" "${target_dir}/${prev_binary:-$app}"
            echo "  文件已还原"
            ;;
        rpm)
            local pkg=$(rpm -qf "$(get_conf "$app" "binary" 2>/dev/null || echo "")" 2>/dev/null)
            if [ -z "$pkg" ]; then
                pkg=$(get_conf "$app" "binary")
                pkg="${pkg%%-*}"
            fi
            sudo dnf downgrade -y "$pkg"
            ;;
    esac

    # 恢复配置
    prev_exec=$(cat "$backup_dir/prev_exec" 2>/dev/null)
    prev_icon=$(cat "$backup_dir/prev_icon" 2>/dev/null)
    [ -n "$prev_exec" ] && set_conf "$app" "exec" "$prev_exec"
    [ -n "$prev_icon" ] && set_conf "$app" "icon" "$prev_icon"
    set_conf "$app" "version" "$prev_ver"

    create_desktop "$app" "$prev_exec" "$prev_icon" "${app^} 应用"
    echo "$app: 已回退到 $prev_ver"
}

# ---------- skip / unskip ----------
cmd_skip() {
    local app=$(resolve_app "${1:-}")
    [ -z "$app" ] && { echo "用法: opt-mgr skip <应用名>"; exit 1; }
    set_conf "$app" "skip" "1"
    echo "$app: 已从批量升级中排除"
}

cmd_unskip() {
    local app=$(resolve_app "${1:-}")
    [ -z "$app" ] && { echo "用法: opt-mgr unskip <应用名>"; exit 1; }
    set_conf "$app" "skip" ""
    echo "$app: 已恢复批量升级"
}

# ---------- clean ----------
cmd_clean() {
    shift  # 去掉 "clean" 子命令
    local dir="$HOME/.cache/opt-mgr/backups"

    if [ "$1" = "all" ]; then
        [ ! -d "$dir" ] && { echo "无备份文件。"; return; }
        local count=$(find "$dir" -type f | wc -l)
        rm -rf "$dir"/*
        echo "全部清理完成, $count 个备份文件已删除。"
        return
    fi

    [ $# -eq 0 ] && { echo "用法: opt-mgr clean all | <应用名>..."; return 1; }

    for target in "$@"; do
        local app=$(resolve_app "$target")
        local app_dir="$dir/$app"
        [ ! -d "$app_dir" ] && { echo "$app: 没有备份文件。"; continue; }
        local count=$(find "$app_dir" -type f | wc -l)
        rm -rf "$app_dir"
        echo "$app: $count 个备份文件已删除。"
    done
}

# ---------- info ----------
cmd_info() {
    local app=$(resolve_app "${1:-}")
    [ -z "$app" ] && { echo "用法: opt-mgr info <应用名>"; exit 1; }

    local app_type=$(get_conf "$app" "type")
    local binary=$(get_conf "$app" "binary")
    local exec_cmd=$(get_conf "$app" "exec")
    local icon=$(get_conf "$app" "icon")
    local target_dir=$(opt_dir "$app")
    local ver=$(get_conf "$app" "version")
    local repo=$(get_conf "$app" "repo")
    local skip=$(get_conf "$app" "skip")

    local skip_info="否"; [ "$skip" = "1" ] && skip_info="是"
    echo "$app:"
    echo "  本地版本: ${ver:-未知}"
    echo "  类型:     ${app_type:-未知}"
    echo "  路径:     ${target_dir:-无}"
    echo "  执行命令: ${exec_cmd:-无}"
    echo "  图标:     ${icon:-无}"
    [ -n "$repo" ] && echo "  仓库:     $repo"
    local pat=$(get_conf "$app" "asset_pattern")
    [ -n "$pat" ] && echo "  匹配模式: $pat"
    [ "$skip" = "1" ] && echo "  批量升级: 已排除"

    if [ -n "$repo" ]; then
        local json api_rc
        json=$(gh_api_latest "$repo")
        api_rc=$?
        if [ $api_rc -eq 0 ] && [ -n "$json" ]; then
            local latest_tag=$(gh_tag_name "$json")
            local latest_ver=$(extract_version "$latest_tag")
            local published=$(gh_published "$json")
            echo ""
            echo "  远程版本: ${latest_ver:-?}  ($published)"
            if [ -n "$ver" ] && [ "$ver" = "$latest_ver" ]; then
                echo "  状态:     ✓ 已是最新"
            elif [ -n "$latest_ver" ]; then
                echo "  状态:     ✦ 有新版本可用!"
            fi
        elif [ $api_rc -eq 2 ]; then
            echo "  远程状态: API 限流"
        else
            echo "  远程状态: 请求失败"
        fi
    fi
}

# ---------- conf ----------
cmd_conf() {
    local app_input="$1"; shift
    local app=$(resolve_app "$app_input")
    local repo="" pattern="" app_type="" icon_opt=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)    repo="$2"; shift ;;
            --type)    app_type="$2"; shift ;;
            --pattern) pattern="$2"; shift ;;
            --icon)    icon_opt="$2"; shift ;;
            *) echo "未知选项: $1"; exit 1 ;;
        esac
        shift
    done

    [ -z "$repo" ] && repo=$(get_conf "$app" "repo")
    [ -z "$repo" ] && { echo "错误: 需要 --repo owner/repo"; echo "格式: opt-mgr conf <应用名> --repo owner/repo [--type tar|jar|appimage] [--pattern 模式] [--icon url]"; exit 1; }

    [ -z "$app_type" ] && app_type=$(get_conf "$app" "type")
    [ -z "$pattern" ] && pattern=$(get_conf "$app" "asset_pattern")

    init_conf
    set_conf "$app" "repo" "$repo"
    [ -n "$app_type" ] && set_conf "$app" "type" "$app_type"
    [ -n "$pattern" ] && set_conf "$app" "asset_pattern" "$pattern"

    # 处理 icon
    if [ -n "$icon_opt" ]; then
        local tmp_icon=$(resolve_icon "$icon_opt" "/tmp" "$app" "$repo")
        if [ -n "$tmp_icon" ]; then
            local icon_name=$(basename "$tmp_icon")
            local icon_dest="$CONF_DIR/icons/${app}.${icon_name##*.}"
            mkdir -p "$CONF_DIR/icons"
            cp "$tmp_icon" "$icon_dest"
            set_conf "$app" "icon" "$icon_dest"
            rm -f "$tmp_icon"
            echo "  图标:   $icon_dest"
        else
            echo "错误: 图标下载失败，配置未保存"; exit 1
        fi
    fi

    echo "已配置 $app:"
    echo "  仓库:   $repo"
    echo "  类型:   ${app_type:-自动检测}"
    echo "  匹配:   ${pattern:-自动检测}"
    echo "  文件:   $CONF_DIR/${app}.conf"
}

# ---------- spec 生成 ----------
gen_spec() {
    local app="$1" ver="$2" repo="$3" ftype="$4" dl_url="$5" binary="$6"
    local strip="$7" icon_name="$8" exec_prefix="$9"
    local pkg="${app,,}"         display="${app^}"
    local icon_source=""         icon_install=""
    local strip_arg=""           exec_line="Exec=%{name}"
    local jar_path="%{_libdir}/%{name}/${binary}"

    [ "$strip" = "1" ] && strip_arg="--strip-components=1"

    # 构建 Exec 行（desktop entry）
    if [ -n "$exec_prefix" ]; then
        if [[ "$exec_prefix" == *\{\}* ]]; then
            exec_line="Exec=${exec_prefix//\{\}/${jar_path}}"
        else
            exec_line="Exec=${exec_prefix} ${jar_path}"
        fi
    elif [ "$ftype" = "jar" ]; then
        exec_line="Exec=java -jar ${jar_path}"
    fi

    if [ -n "$icon_name" ]; then
        icon_source="
Source1:        ${icon_name}"
        icon_install="
mkdir -p %{buildroot}%{_datadir}/icons/hicolor/256x256/apps
install -m 644 %{SOURCE1} %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/%{name}.${icon_name##*.}"
    fi

    local install_cmd=""
    case "$ftype" in
        rpm)
            install_cmd="rpm2cpio %{SOURCE0} | cpio -idmv
find . -path ./BUILDROOT -prune -o -type f -print -o -type l -print | sed 's|^\\./|/|' > ../%{name}.files
for d in */; do case \"\$d\" in BUILDROOT/|SPECPARTS/) ;; *) cp -a \"\$d\" %{buildroot}/ ;; esac; done"
            ;;
        tar)
            install_cmd="tar xzf %{SOURCE0} -C %{buildroot}%{_libdir}/%{name} ${strip_arg}
for f in %{buildroot}%{_libdir}/%{name}/${binary} %{buildroot}%{_libdir}/%{name}/lib/*.so; do
    chrpath -r '\$ORIGIN/lib' \"\$f\" 2>/dev/null || true
done
chmod +x %{buildroot}%{_libdir}/%{name}/${binary}"
            ;;
        jar)
            local wrapper_cmd="${exec_prefix:-java -jar}"
            if [[ "$wrapper_cmd" == *\{\}* ]]; then
                wrapper_cmd="${wrapper_cmd//\{\}/${jar_path}}"
            else
                wrapper_cmd="${wrapper_cmd} ${jar_path}"
            fi
            install_cmd="install -m 644 %{SOURCE0} %{buildroot}%{_libdir}/%{name}/${binary}
cat > %{buildroot}%{_bindir}/%{name} <<WRAPEOF
#!/bin/sh
exec ${wrapper_cmd} \"\$@\"
WRAPEOF
chmod +x %{buildroot}%{_bindir}/%{name}"
            ;; 
        appimage|file)
            install_cmd="install -m 755 %{SOURCE0} %{buildroot}%{_libdir}/%{name}/${binary}"
            ;;
    esac

    local requires=""
    [ "$ftype" = "jar" ] && requires="Requires:       java"

    local ln_cmd="ln -s %{_libdir}/%{name}/${binary} %{buildroot}%{_bindir}/%{name}"
    [ "$ftype" = "jar" ] && ln_cmd=""   # jar 用自建 wrapper
    [ "$ftype" = "rpm" ] && ln_cmd=""   # rpm 自带文件布局
    local files_section="%{_bindir}/%{name}
%{_libdir}/%{name}/
%{_datadir}/applications/%{name}.desktop"
    [ "$ftype" = "rpm" ] && files_section="-f %{name}.files"
    local desktop_block="mkdir -p %{buildroot}%{_datadir}/applications
cat > %{buildroot}%{_datadir}/applications/%{name}.desktop <<DESKEOF
[Desktop Entry]
Name=${display}
Comment=${display} 应用
${exec_line}
Icon=%{name}
Terminal=false
Type=Application
Categories=Utility;
StartupWMClass=${display}
DESKEOF"
    [ "$ftype" = "rpm" ] && desktop_block=""
    [ "$ftype" = "rpm" ] && check_block="" || check_block="desktop-file-validate %{buildroot}%{_datadir}/applications/%{name}.desktop"

    cat > "$HOME/rpmbuild/SPECS/${app}.spec" <<SPECEOF
%global debug_package %{nil}
%global __provides_exclude ^(%{_libdir}/%{name}/.*\\.so)
%global __requires_exclude ^(libmpv|libflutter|libdart|libapp).*

Name:           ${pkg}
Version:        ${ver}
Release:        1%{?dist}
Summary:        ${display} 应用

License:        Unknown
URL:            https://github.com/${repo}
Source0:        ${dl_url}${icon_source}
${requires}
BuildRequires:  desktop-file-utils
BuildRequires:  chrpath
BuildRequires:  rpm-build

%description
${display} 第三方应用。

%prep
mkdir -p %{name}-%{version}
cd %{name}-%{version}

%build

%install
mkdir -p %{buildroot}%{_libdir}/%{name} %{buildroot}%{_bindir} %{buildroot}%{_datadir}/applications
${install_cmd}
${ln_cmd}${icon_install}
${desktop_block}
%check
${check_block}

%files
${files_section}
SPECEOF

    if [ -n "$icon_name" ]; then
        echo "%{_datadir}/icons/hicolor/256x256/apps/%{name}.${icon_name##*.}" >> "$HOME/rpmbuild/SPECS/${app}.spec"
    fi

    cat >> "$HOME/rpmbuild/SPECS/${app}.spec" <<SPECEOF

%changelog
* $(LC_TIME=C date +"%a %b %d %Y") Maomaokuxs <biyuanh@qq.com> - ${ver}-1
- Auto-generated by opt-mgr build
SPECEOF

    mkdir -p "$CONF_DIR/specs"
    cp "$HOME/rpmbuild/SPECS/${app}.spec" "$CONF_DIR/specs/${app}.spec"
    echo "  已生成 spec: $HOME/rpmbuild/SPECS/${app}.spec"
}

# ---------- build ----------
cmd_build() {
    local app_input="$1"
    [ $# -ge 1 ] || { echo "用法: opt-mgr build <应用名> [--repo owner/repo] [--copr 仓库] [--icon 路径] [--exec 前缀] [--pattern 模式]"; exit 1; }
    shift

    local app=$(resolve_app "$app_input")
    local repo="" copr_repo="apps" icon_opt="" exec_prefix="" pattern="" app_type=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)    repo="$2"; shift ;;
            --copr)    copr_repo="$2"; shift ;;
            --icon)    icon_opt="$2"; shift ;;
            --exec)    exec_prefix="$2"; shift ;;
            --pattern) pattern="$2"; shift ;;
            --type)    app_type="$2"; shift ;;
            *) echo "未知选项: $1"; exit 1 ;;
        esac
        shift
    done

    [ -z "$repo" ] && repo=$(get_conf "$app" "repo")
    [ -z "$repo" ] && { echo "错误: 需要 --repo owner/repo"; exit 1; }

    # 从 .conf 读取 exec_prefix 和 icon
    if [ -z "$exec_prefix" ]; then
        local stored_exec=$(get_conf "$app" "exec")
        if [ -n "$stored_exec" ]; then
            local opt_dir=$(get_conf "$app" "opt_dir")
            local conf_binary=$(get_conf "$app" "binary")
            if [ -n "$opt_dir" ] && [ -n "$conf_binary" ]; then
                exec_prefix="${stored_exec//"${opt_dir}/${conf_binary}"/\{\}}"
            else
                exec_prefix="${stored_exec}"
            fi
        fi
    fi
    if [ -z "$icon_opt" ]; then
        local stored_icon=$(get_conf "$app" "icon")
        [ -n "$stored_icon" ] && [ -f "$stored_icon" ] && icon_opt="$stored_icon"
    fi

    local current_ver=$(get_conf "$app" "version")
    [ -z "$app_type" ] && app_type=$(get_conf "$app" "type")
    local icon_name=""

    echo "===== 构建 $app RPM 包 ====="
    echo "  仓库: $repo"

    init_conf
    mkdir -p "$HOME/rpmbuild/SOURCES" "$HOME/rpmbuild/SPECS"

    # 从 .conf 读取缺失参数
    [ -z "$icon_opt" ] && { local si=$(get_conf "$app" "icon"); [ -n "$si" ] && [ -f "$si" ] && icon_opt="$si"; }

    # 提前检查图标（避免下载完再报错）
    local need_icon=true
    [ "$app_type" = "jar" ] || [ "$app_type" = "rpm" ] && need_icon=false
    if [ -n "$icon_opt" ]; then
        local resolved=$(resolve_icon "$icon_opt" "$HOME/rpmbuild/SOURCES" "$app" "$repo")
        if [ -n "$resolved" ]; then
            icon_name=$(basename "$resolved")
            echo "  图标: $icon_name"
        else
            echo "错误: 图标获取失败，请检查路径"
            [ -n "$repo" ] && echo "  完整 URL: https://raw.githubusercontent.com/${repo}/main/${icon_opt#/}"
            exit 1
        fi
    elif $need_icon; then
        echo "错误: 需要 --icon <路径|URL>"
        echo "  相对路径: https://raw.githubusercontent.com/${repo:-owner/repo}/main/<路径>"
        exit 1
    fi

    # 获取最新 release
    local json
    json=$(gh_api_latest "$repo")
    local api_rc=$?
    if [ $api_rc -ne 0 ]; then
        [ $api_rc -ne 2 ] && echo "错误: GitHub API 请求失败"
        exit 1
    fi

    local latest_tag=$(echo "$json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tag_name',''))" 2>/dev/null)
    local latest_ver=$(extract_version "$latest_tag")
    echo "  版本: $latest_ver"

    # 匹配 asset
    [ -z "$pattern" ] && pattern=$(get_conf "$app" "asset_pattern")
    pattern="${pattern:-$(default_pattern "$app_type")}"

    local result download_url asset_name
        result=$(echo "$json" | python3 -c "
import sys, json, fnmatch
data = json.load(sys.stdin)
for a in data.get('assets', []):
    if fnmatch.fnmatch(a['name'], '${pattern:-*}'):
        print(a['browser_download_url'])
        print(a['name'])
        break
" 2>/dev/null)
    download_url=$(echo "$result" | head -1)
    asset_name=$(echo "$result" | tail -1)
    [ -z "$download_url" ] && { echo "错误: 未匹配到下载文件 (模式: ${pattern:-*})"; exit 1; }

    echo "  下载: $asset_name"
    local source_path="$HOME/rpmbuild/SOURCES/$asset_name"
    download_file "$download_url" "$source_path" || { echo "错误: 下载失败"; rm -f "$source_path"; exit 1; }

    # 分析文件
    [ -z "$app_type" ] && app_type=$(detect_file_type "$asset_name")
    local ftype="$app_type"
    local binary="" strip=""

    case "$ftype" in
        jar)
            binary="$asset_name"
            echo "  类型: jar"
            ;;
        appimage|file)
            binary="$asset_name"
            echo "  类型: $ftype"
            ;;
        tar)
            echo "  类型: tar"
            local tmpdir=$(mktemp -d /tmp/opt-mgr-build.XXXXXX)
            tar xzf "$source_path" -C "$tmpdir" 2>/dev/null

            local unique=$(tar tzf "$source_path" | cut -d/ -f1 | sort -u | wc -l)
            local search_dir="$tmpdir"
            [ "$unique" -eq 1 ] && { search_dir="$tmpdir/$(tar tzf "$source_path" | cut -d/ -f1 | sort -u)"; strip="1"; }

            binary=$(find_binary "$search_dir" "$app")
            echo "  可执行文件: $binary"
            rm -rf "$tmpdir"
            ;;
        rpm)
            echo "提示: .conf 中类型为 rpm，跳过构建"
            echo "  如果仓库也提供 tar.gz，可以:"
            echo "    opt-mgr build $app --type tar --pattern '*tar.gz 匹配模式'"
            echo "  或直接用 RPM: sudo dnf install $download_url"
            rm -f "$source_path"
            exit 0
            ;;
    esac

    # 生成 spec
    gen_spec "$app" "$latest_ver" "$repo" "$ftype" "$download_url" "$binary" "$strip" "$icon_name" "$exec_prefix"

    # 构建 SRPM
    echo "===== 构建 SRPM ====="
    rpmbuild -bs "$HOME/rpmbuild/SPECS/${app}.spec" || { echo "错误: SRPM 构建失败"; exit 1; }

    # 提交 COPR
    echo "===== 提交到 COPR: $copr_repo ====="
    if copr-cli list "$copr_repo" &>/dev/null; then
        copr-cli build "$copr_repo" "$HOME/rpmbuild/SRPMS/${app,,}-${latest_ver}-1.fc44.src.rpm"
    else
        echo "  仓库 $copr_repo 不存在，正在创建..."
        copr-cli create "$copr_repo" --chroot fedora-44-x86_64 --description "第三方应用软件仓库"
        copr-cli build "$copr_repo" "$HOME/rpmbuild/SRPMS/${app,,}-${latest_ver}-1.fc44.src.rpm"
    fi

    echo "===== 完成 ====="
    echo "  COPR: https://copr.fedorainfracloud.org/coprs/$(whoami)/${copr_repo}/"
    echo "  安装: sudo dnf copr enable $(whoami)/${copr_repo} && sudo dnf install ${app,,}"
}

# ---------- 入口 ----------
[ $# -ge 1 ] || usage

case "$1" in
    install)  shift; cmd_install  "$@" ;;
    remove)   shift; cmd_remove   "$@" ;;
    conf)     shift; cmd_conf     "$@" ;;
    build)    shift; cmd_build    "$@" ;;
    clean)    shift; cmd_clean    "$@" ;;
    rollback) cmd_rollback "${2:-}" ;;
    skip)     cmd_skip     "${2:-}" ;;
    unskip)   cmd_unskip   "${2:-}" ;;
    info)     cmd_info     "${2:-}" ;;
    set-repo) cmd_set_repo "${2:-}" "$3" "$4" ;;
    check)    cmd_check    "${2:-}" ;;
    upgrade)  cmd_upgrade  "${2:-}" ;;
    list)     cmd_list ;;
    *)        usage ;; 
esac
