# bash completion for opt-mgr
_opt_mgr_completion() {
    local cur prev cmd
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmd="${COMP_WORDS[1]}"

    local commands="install reinstall remove rollback skip unskip info list set-repo check upgrade clean build conf"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
        return
    fi

    # 提取已管理应用列表
    local apps=()
    shopt -s nullglob
    for conf in "$HOME/.config/opt-mgr/"*.conf; do
        apps+=("$(basename "$conf" .conf)")
    done
    shopt -u nullglob

    # 通用选项
    local common_opts="--type --repo --pattern --icon --exec"

    case "$cmd" in
        remove)
            case "$prev" in
                remove)  COMPREPLY=($(compgen -W "${apps[*]}" -- "$cur")) ;;
                *)       COMPREPLY=($(compgen -W "--purge" -- "$cur")) ;; 
            esac
            ;;
        rollback|skip|unskip|info)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -W "${apps[*]}" -- "$cur"))
            fi
            ;;
        install|reinstall)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -W "${apps[*]}" -f -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$common_opts" -- "$cur"))
            fi
            ;;
        build)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -W "${apps[*]}" -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$common_opts --copr" -- "$cur"))
            fi
            ;;
        conf)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=($(compgen -f -- "$cur"))
            else
                COMPREPLY=($(compgen -W "$common_opts" -- "$cur"))
            fi
            ;;
        check|upgrade)
            COMPREPLY=($(compgen -W "all ${apps[*]}" -- "$cur"))
            ;;
        clean)
            COMPREPLY=($(compgen -W "all ${apps[*]}" -- "$cur"))
            ;;
    esac
}

complete -F _opt_mgr_completion opt-mgr
