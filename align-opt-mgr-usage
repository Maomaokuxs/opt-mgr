#!/usr/bin/env python3
"""对齐 opt-mgr 帮助输出中所有 # 注释列（全局对齐）"""
import re, sys, os, unicodedata

FILE = os.path.expanduser("~/.local/opt-mgr/opt-mgr")

def display_width(s):
    w = 0
    for c in s:
        w += 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1
    return w

def align():
    with open(FILE) as f:
        content = f.read()

    m = re.search(r"cat <<'EOF'\n(.*?)\nEOF", content, re.DOTALL)
    if not m:
        print("错误: 找不到 usage 函数"); sys.exit(1)

    raw = m.group(1)
    raw_lines = raw.split('\n')

    # 全局计算最大宽度
    max_w = 0
    for line in raw_lines:
        for sep in ('  #', ' #', '\t#'):
            if sep in line:
                body = line[:line.rindex(sep)].rstrip()
                max_w = max(max_w, display_width(body))
                break

    # 重新生成每行
    new_lines = []
    for line in raw_lines:
        stripped = line.rstrip()
        matched = False
        for sep in ('  #', ' #', '\t#'):
            if sep in stripped:
                idx = stripped.rindex(sep)
                body = stripped[:idx].rstrip()
                comment = stripped[idx + len(sep) - 1:]
                pad = max_w - display_width(body) + 4
                new_lines.append(f"{body}{' ' * pad}{comment}")
                matched = True
                break
        if not matched:
            new_lines.append(stripped)

    new_body = '\n'.join(new_lines)
    content = content.replace(raw, new_body)
    with open(FILE, 'w') as f:
        f.write(content)

    print(f"对齐完成 ({len(raw_lines)} 行)")

if __name__ == "__main__":
    align()
