#!/usr/bin/env python3
"""对齐 opt-mgr 用法中 # 注释列"""
import sys, os, unicodedata

FILE = os.path.expanduser("~/.local/bin/opt-mgr")

def display_width(s):
    w = 0
    for c in s:
        w += 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1
    return w

def align():
    with open(FILE) as f:
        content = f.read()

    # 找到 "用法:" 到下一个分区标题之间的行
    start = content.find("用法:\n")
    if start < 0:
        print("错误: 找不到 '用法:'"); sys.exit(1)

    end = content.find("\ninstall 选项:", start)
    if end < 0:
        print("错误: 找不到 'install 选项:'"); sys.exit(1)

    old = content[start:end]
    lines = []
    for raw in old.strip().split('\n')[1:]:  # 跳过 "用法:"
        # 分离命令和注释
        cmd = raw.strip()
        comment = ""
        if '  #' in cmd:
            idx = cmd.rindex('  #')
            comment = cmd[idx+2:]  # 含 '#'
            cmd = cmd[:idx].rstrip()
        elif ' #' in cmd:
            idx = cmd.rindex(' #')
            comment = cmd[idx+1:]
            cmd = cmd[:idx].rstrip()
        elif '\t#' in cmd:
            idx = cmd.rindex('\t#')
            comment = cmd[idx+1:]
            cmd = cmd[:idx].rstrip()
        if cmd:
            lines.append((f"  {cmd}", comment))  # 统一加前导空格

    if not lines:
        print("错误: 没有需要对齐的行"); sys.exit(1)

    max_w = max(display_width(cmd) for cmd, _ in lines)

    new_block = "用法:\n"
    for cmd, comment in lines:
        pad = max_w - display_width(cmd) + 4
        new_block += f"{cmd}{' ' * pad}{comment}\n"

    content = content.replace(old, new_block.rstrip('\n'))
    with open(FILE, 'w') as f:
        f.write(content)

    print(f"对齐完成 ({len(lines)} 行)")

if __name__ == "__main__":
    align()
