#!/usr/bin/env python3
"""对齐 opt-mgr 帮助输出中所有 # 注释列"""
import re, sys, os, unicodedata

FILE = os.path.expanduser("~/.local/bin/opt-mgr")

def display_width(s):
    w = 0
    for c in s:
        w += 2 if unicodedata.east_asian_width(c) in ('W', 'F') else 1
    return w

def align_lines(lines):
    """对齐一组行中的 # 注释"""
    if not lines:
        return lines
    # 计算最大宽度（只算有注释的行）
    max_w = 0
    for line in lines:
        stripped = line.rstrip()
        for sep in ('  #', ' #', '\t#'):
            if sep in stripped:
                body = stripped[:stripped.rindex(sep)].rstrip()
                max_w = max(max_w, display_width(body))
                break
    if max_w == 0:
        return lines

    result = []
    for line in lines:
        stripped = line.rstrip()
        matched = False
        for sep in ('  #', ' #', '\t#'):
            if sep in stripped:
                idx = stripped.rindex(sep)
                body = stripped[:idx].rstrip()
                comment = stripped[idx + len(sep) - 1:]  # 含 '#'
                pad = max_w - display_width(body) + 4
                result.append(f"{body}{' ' * pad}{comment}")
                matched = True
                break
        if not matched:
            result.append(stripped)
    return result

def align():
    with open(FILE) as f:
        content = f.read()

    m = re.search(r"cat <<'EOF'\n(.*?)\nEOF", content, re.DOTALL)
    if not m:
        print("错误: 找不到 usage 函数"); sys.exit(1)

    raw = m.group(1)
    section_lines = raw.split('\n')

    # 按空行分组，每组独立对齐
    groups = []
    buf = []
    for line in section_lines:
        stripped = line.rstrip()
        if stripped == '':
            groups.append(buf)
            buf = []
        else:
            buf.append(stripped)
    if buf:
        groups.append(buf)

    new_sections = []
    for g in groups:
        new_sections.append('\n'.join(align_lines(g)))

    new_body = '\n'.join(new_sections)
    content = content.replace(raw, new_body)
    with open(FILE, 'w') as f:
        f.write(content)

    print(f"对齐完成 ({len(section_lines)} 行)")

if __name__ == "__main__":
    align()
